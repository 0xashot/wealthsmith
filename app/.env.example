# Optional: dedicated Solana RPC endpoint for read-only wallet balance/token reads.
# Copy this file to `.env.local` and set the URL. Local dev works without it.
#
# Why you may want this:
#   - The official https://api.mainnet-beta.solana.com endpoint BLOCKS browser
#     requests (CORS/403), so from a web app every read fails against it.
#   - The app therefore defaults to a CORS-enabled public node
#     (https://solana-rpc.publicnode.com), which reads native SOL reliably.
#   - BUT getParsedTokenAccountsByOwner (SPL / Token-2022 token balances) is an
#     expensive indexed method that keyless public RPCs generally do NOT serve.
#     To read token balances, point this at a dedicated RPC that supports it,
#     e.g. Helius / QuickNode / Alchemy / Triton (most have a free tier + key).
#
# Read-only only: this endpoint is never used to sign or send transactions.
# Do NOT commit a private key or a secret-bearing URL.
VITE_SOLANA_RPC_URL=

# ---------------------------------------------------------------------------
# Step 22E — CoinMarketCap CMC Crypto Fear & Greed (market-conditions source).
# SERVER / OFFLINE ONLY. Used exclusively by `npm run market:refresh-conditions`
# (scripts/refresh-market-conditions.mjs) to fetch the index and publish a static
# cache artifact. NEVER prefix with VITE_ — it must not enter the client bundle,
# the suggestion engine, React, or any cache file/log. Sent via the required
# X-CMC_PRO_API_KEY header (never a query param). Fixtures never need a real key.
# In CI the scheduled refresh (.github/workflows/refresh-market-conditions.yml)
# reads this from the GitHub repository secret of the same name.
COINMARKETCAP_API_KEY=

# ---------------------------------------------------------------------------
# Step 23B.1 — Live Swap-Quote service (SERVER / OFFLINE ONLY). Never VITE_-prefixed;
# these must NEVER reach the browser bundle. Used by `npm run swap:serve` / `swap:smoke`
# and the deployed Node web service. The static SPA reaches the service via the dev proxy
# (/api/swap-quote → localhost:8787) or, in production, VITE_SWAP_QUOTE_API_BASE.
# ---------------------------------------------------------------------------
# Optional overrides (public endpoints are used by default):
# SWAP_PRICE_URL=        # approved mirror of Jupiter Price v3 (shared USD snapshot)
# SWAP_LIQUIDITY_URL=    # approved mirror of Raydium pools/info (per-leg pool TVL)
# JUPITER_QUOTE_URL=     # approved mirror of api.jup.ag/swap/v1/quote
# RAYDIUM_QUOTE_URL=     # approved mirror of transaction-v1.raydium.io/compute/swap-base-in
# JUPITER_QUOTE_API_KEY= # only if a paid Jupiter tier is used (public tier needs none)
# Required for Orca (read-only Whirlpool account reads); missing → Orca unavailable, others continue:
# SOLANA_RPC_URL=        # server-only Solana RPC (e.g. Helius/QuickNode/Triton). NOT the VITE_ one.
# Server runtime:
# PORT=8787
# SWAP_ALLOWED_ORIGIN=   # single approved browser origin for CORS (e.g. https://app.example.com)
# SWAP_QUOTE_DEV_TARGET= # dev proxy target override (default http://localhost:8787)
# Client (Step 23C, not used yet): VITE_SWAP_QUOTE_API_BASE=  # deployed service base URL

# ---------------------------------------------------------------------------
# Internal preview gates (build-time). MUST stay unset in production builds —
# both fail closed. DEV builds enable the /testing gallery automatically.
# ---------------------------------------------------------------------------
# VITE_ENABLE_TESTING_PAGE=true       # /testing suggestion-card gallery (staging only)
# VITE_INTERNAL_SOL_LST_PREVIEW=true  # internal SOL LST preview route
