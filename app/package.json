{
  "name": "wealthsmith",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "test": "node scripts/run-fixtures.mjs --quiet",
    "test:verbose": "node scripts/run-fixtures.mjs",
    "deadcode": "knip --include files",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "market:refresh-staking": "node scripts/refresh-sol-staking-market-data.mjs",
    "market:publish-staking": "node scripts/publish-sol-staking-market-cache.mjs",
    "market:refresh-and-publish-staking": "npm run market:refresh-staking && npm run market:publish-staking",
    "probe:stable-yield": "node scripts/probe-stable-yield-sources.mjs",
    "refresh:stable-yield-market-data": "node scripts/refresh-stable-yield-market-data.mjs",
    "publish:stable-yield-market-cache": "node scripts/publish-stable-yield-market-cache.mjs",
    "validate:stable-yield-market-cache": "node scripts/publish-stable-yield-market-cache.mjs --validate-only",
    "market:refresh-conditions": "node scripts/refresh-market-conditions.mjs",
    "market:validate-conditions": "node scripts/validate-market-conditions-cache.mjs",
    "build:deploy": "npm run market:refresh-conditions && npm run build",
    "swap:build-server": "node scripts/build-swap-server.mjs",
    "swap:serve": "npm run swap:build-server && node dist-server/swap-quote-server.mjs",
    "swap:serve-execute": "npm run swap:build-server && node dist-server/swap-execute-server.mjs",
    "swap:smoke": "node scripts/swap-quote-smoke.mjs",
    "swap:smoke-execute": "node scripts/swap-execute-smoke.mjs"
  },
  "dependencies": {
    "@hubbleprotocol/hubble-sdk": "^8.0.4",
    "@jito-foundation/vault-sdk": "1.0.0",
    "@kamino-finance/klend-sdk": "9.1.2",
    "@meteora-ag/dlmm": "1.9.11",
    "@meteora-ag/dynamic-amm-sdk": "1.4.1",
    "@orca-so/whirlpools-core": "2.0.0",
    "@solana/kit": "^2.3.0",
    "@solana/spl-stake-pool": "1.1.8",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.38",
    "@solana/web3.js": "^1.98.4",
    "buffer": "^6.0.3",
    "lottie-react": "^2.4.1",
    "posthog-js": "^1.449.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "@kamino-finance/farms-sdk": "3.2.24",
    "@solana/web3.js": "$@solana/web3.js"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "knip": "^6.32.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
