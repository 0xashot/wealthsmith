{
  "template_metadata": {
    "name": "Demo Mode State Template",
    "path": "templates/demo-mode-state-template.json",
    "purpose": "Reusable structure for WealthSmith Demo Mode state used by Dashboard, Portfolio, Goal, Suggestions, Smith AI, onboarding entry points, QA, and Claude Code.",
    "template_type": "json_contract_template",
    "source_of_truth": [
      "rules/demo-mode-rules.md",
      "rules/wallet-and-custody-rules.md",
      "rules/suggestion-engine-rules.md",
      "rules/top-pick-rules.md",
      "rules/protocol-selection-rules.md",
      "rules/smith-ai-rules.md",
      "rules/financial-logic-boundaries.md",
      "rules/loading-state-rules.md"
    ],
    "related_content": [
      "content/demo-mode-copy.md",
      "content/wallet-copy.md",
      "content/suggestion-card-copy.md",
      "content/smith-ai-copy.md",
      "content/empty-error-loading-copy.md",
      "content/glossary.md"
    ],
    "related_components": [
      "components/global-nav.md",
      "components/announcement.md",
      "components/card.md",
      "components/metric-card.md",
      "components/portfolio-card.md",
      "components/suggestion-card.md",
      "components/table.md",
      "components/chart.md",
      "components/button.md",
      "components/toast.md"
    ],
    "related_patterns": [
      "patterns/dashboard-layout.md",
      "patterns/portfolio-overview.md",
      "patterns/suggestion-flow.md",
      "patterns/wallet-connection.md",
      "patterns/onboarding-with-smith-ai.md",
      "patterns/empty-loading-error-states.md"
    ],
    "related_templates": [
      "templates/page-state-template.json",
      "templates/wallet-state-template.json",
      "templates/suggestion-object-template.json",
      "templates/top-pick-output-template.json",
      "templates/protocol-decision-template.json",
      "templates/smith-ai-context-template.json",
      "templates/empty-error-loading-state-template.json"
    ],
    "related_examples": [
      "examples/demo-mode/demo-portfolio.json",
      "examples/demo-mode/demo-dashboard-state.json",
      "examples/demo-mode/demo-suggestions.json",
      "examples/demo-mode/demo-smith-ai-responses.md",
      "examples/dashboard/dashboard-demo-state.json"
    ],
    "notes": [
      "This is a template, not production demo data.",
      "Demo Mode must clearly label sample data.",
      "Demo Mode must not imply real wallet personalization.",
      "Demo Mode has no wallet pill and does not request wallet signatures.",
      "Demo Top Pick is sample-only and must not persist into real wallet mode."
    ]
  },
  "demo_mode_state": {
    "id": "{demo_mode_state_id}",
    "source": "{demo_state_builder|test_fixture|storybook_fixture}",
    "status": "{ready|loading|error}",
    "generated_at": "{timestamp_from_system}",
    "mode": "demo",
    "demo_mode": true,
    "is_sample_data": true,
    "sample_data_label_required": true,
    "wallet_state": {
      "template_reference": "templates/wallet-state-template.json",
      "status": "demo",
      "real_wallet_connected": false,
      "provider": null,
      "provider_id": null,
      "address_short": null,
      "network": "solana",
      "connection_type": "demo",
      "wallet_pill_visible": false,
      "permissions": {
        "can_read_public_address": false,
        "can_read_supported_balances": false,
        "can_read_supported_positions": false,
        "can_move_funds": false,
        "can_trade": false,
        "can_swap": false,
        "can_stake": false,
        "can_unstake": false,
        "can_deposit": false,
        "can_withdraw": false,
        "can_rebalance": false,
        "can_sign_transactions": false
      },
      "hard_rules": [
        "Demo Mode is not connected to a real wallet.",
        "Do not show wallet pill in Demo Mode.",
        "Do not use demo data as real wallet data.",
        "Do not request wallet signature in Demo Mode."
      ]
    },
    "global_nav": {
      "component": "global-nav",
      "variant": "demo_mode",
      "logo": {
        "asset": "assets/logo/wealthsmith-full-lockup.svg",
        "alt": "WealthSmith",
        "width_px": 221,
        "height_px": 32
      },
      "nav_items": [
        {
          "id": "dashboard",
          "label": "Dashboard",
          "href": "/dashboard",
          "active": "{boolean}",
          "disabled": false
        },
        {
          "id": "portfolio",
          "label": "Portfolio",
          "href": "/portfolio",
          "active": "{boolean}",
          "disabled": false
        },
        {
          "id": "goal",
          "label": "Goal",
          "href": "/goal",
          "active": "{boolean}",
          "disabled": false
        },
        {
          "id": "support",
          "label": "Support",
          "href": "/support",
          "active": "{boolean}",
          "disabled": false
        }
      ],
      "right_actions": {
        "try_demo_mode": {
          "visible": false,
          "reason": "Demo Mode is already active."
        },
        "connect_wallet": {
          "visible": false,
          "reason": "Demo Mode uses sample data. Connect Wallet can appear in the demo banner or page CTA instead."
        },
        "wallet_pill": {
          "visible": false,
          "reason": "No real wallet is connected in Demo Mode."
        },
        "ask_smith_ai": {
          "visible": true,
          "label": "Ask Smith AI",
          "action": "open_smith_ai_panel",
          "content_id": "smith_ai.cta.ask"
        }
      },
      "hard_rules": [
        "Demo Mode global nav must not show wallet pill.",
        "Demo Mode global nav must not show Try Demo Mode because the user is already in demo.",
        "Ask Smith AI is available in Demo Mode.",
        "All primary nav items can be enabled because Demo Mode provides sample state."
      ]
    },
    "demo_banner": {
      "visible": true,
      "component": "announcement",
      "placement": "below_global_nav",
      "severity": "info",
      "title": "Demo Mode",
      "description": "You’re viewing sample data. Connect a wallet to see your own portfolio.",
      "content_ids": {
        "title": "demo.banner.title",
        "description": "demo.banner.description",
        "connect_wallet_cta": "wallet.connect.cta",
        "exit_demo_cta": "demo.cta.exit_demo"
      },
      "actions": [
        {
          "label": "Connect Wallet",
          "action": "open_connect_wallet_modal",
          "variant": "primary",
          "executes_transaction": false,
          "requires_wallet_signature": false
        },
        {
          "label": "Exit Demo",
          "action": "exit_demo_mode",
          "variant": "secondary",
          "executes_transaction": false,
          "requires_wallet_signature": false
        }
      ],
      "hard_rules": [
        "Demo banner must be visible when demo_mode = true.",
        "Demo banner must be outside Global Nav.",
        "Demo banner must clearly label sample data.",
        "Demo banner CTAs do not execute transactions.",
        "Connect Wallet opens wallet connection flow and does not reuse demo data as real data."
      ]
    },
    "demo_goal": {
      "status": "ready",
      "source": "demo_goal_fixture",
      "is_sample_data": true,
      "financial_goal": {
        "label": "{demo_financial_goal_label}",
        "value": "{demo_financial_goal_value}"
      },
      "risk_tolerance": {
        "label": "{Low|Medium|High}",
        "value": "{low|medium|high}"
      },
      "time_horizon": {
        "label": "{time_horizon_label}",
        "value_years": "{number}"
      },
      "monthly_income_usd": "{number}",
      "monthly_expenses_usd": "{number}",
      "contribution_rhythm": {
        "label": "{Weekly|Monthly|None}",
        "value": "{weekly|monthly|none}"
      },
      "monthly_saving_goal_usd": "{number_or_null}",
      "hard_rules": [
        "Demo goal is sample data.",
        "Demo goal must be clearly labeled when explained by Smith AI.",
        "Demo goal must not be saved as the user's real goal unless user explicitly creates real settings."
      ]
    },
    "demo_portfolio": {
      "status": "ready",
      "source": "demo_portfolio_fixture",
      "is_sample_data": true,
      "total_value_usd": "{number}",
      "assets": [
        {
          "symbol": "{token_symbol}",
          "name": "{token_name}",
          "category": "{crypto|stablecoin|meme|governance|lst|rwa|unknown}",
          "value_usd": "{number}",
          "percentage_of_portfolio": "{number_from_demo_fixture}",
          "position_type": "{liquid|staked|yield_strategy}",
          "icon": "{approved_token_icon_path_or_fallback}",
          "is_sample_data": true
        }
      ],
      "deployment_summary": {
        "liquid_assets_value_usd": "{number}",
        "staked_assets_value_usd": "{number}",
        "yield_strategies_value_usd": "{number}",
        "source": "demo_portfolio_fixture",
        "must_not_invent": true
      },
      "safety_buffer": {
        "status": "{underfunded|funded|unknown}",
        "current_buffer_usd": "{number_from_demo_fixture}",
        "target_buffer_usd": "{number_from_demo_fixture}",
        "buffer_gap_usd": "{number_from_demo_fixture}",
        "coverage_percent": "{number_from_demo_fixture}",
        "months_covered": "{number_from_demo_fixture}",
        "target_months": "{number_from_demo_fixture}",
        "source": "demo_safety_buffer_fixture",
        "must_not_invent": true
      },
      "hard_rules": [
        "Demo portfolio is sample data.",
        "Demo portfolio must not be presented as real wallet data.",
        "Do not show wallet pill for demo portfolio.",
        "Do not request signatures for demo portfolio.",
        "Do not invent missing demo balances."
      ]
    },
    "demo_suggestions": {
      "status": "ready",
      "source": "demo_suggestion_fixture",
      "template_reference": "templates/suggestion-object-template.json",
      "is_sample_data": true,
      "suggestions": [
        "{suggestion_object_from_demo_fixture}"
      ],
      "hard_rules": [
        "Demo suggestions are sample suggestions.",
        "Demo suggestions must follow the same object shape as real suggestions.",
        "Demo suggestions are not real recommendations.",
        "Demo suggestions must not execute transactions.",
        "Demo suggestions must not request wallet signatures.",
        "Demo suggestions must not persist into real wallet mode."
      ]
    },
    "demo_top_pick": {
      "status": "{ready|no_valid_top_pick|error}",
      "source": "demo_top_pick_fixture",
      "template_reference": "templates/top-pick-output-template.json",
      "is_sample_data": true,
      "has_top_pick": "{boolean}",
      "top_pick_id": "{suggestion_id_or_null}",
      "top_pick_title": "{suggestion_title_or_null}",
      "selection_reason": "{reason_from_demo_top_pick_fixture_or_null}",
      "reason_codes": [
        "{reason_code}"
      ],
      "hard_rules": [
        "Demo Top Pick is selected from demo suggestions only.",
        "Demo Top Pick must be labeled as sample when explained.",
        "Demo Top Pick must not persist after connecting a real wallet.",
        "Smith AI must not choose or change Demo Top Pick."
      ]
    },
    "page_state_integration": {
      "template_reference": "templates/page-state-template.json",
      "dashboard": {
        "route": "/dashboard",
        "mode": "demo",
        "demo_banner_visible": true,
        "wallet_pill_visible": false,
        "right_rail_mode": "{suggestions|ask_smith_ai|strategy_insights}",
        "main_content_source": "demo_portfolio_and_demo_goal"
      },
      "portfolio": {
        "route": "/portfolio",
        "mode": "demo",
        "demo_banner_visible": true,
        "wallet_pill_visible": false,
        "main_content_source": "demo_portfolio"
      },
      "goal": {
        "route": "/goal",
        "mode": "demo",
        "demo_banner_visible": true,
        "wallet_pill_visible": false,
        "main_content_source": "demo_goal"
      },
      "support": {
        "route": "/support",
        "mode": "demo",
        "demo_banner_visible": true,
        "wallet_pill_visible": false,
        "main_content_source": "support_content"
      }
    },
    "smith_ai_context": {
      "template_reference": "templates/smith-ai-context-template.json",
      "available": true,
      "context_mode": "demo",
      "demo_mode": true,
      "is_sample_data": true,
      "sample_data_label_required": true,
      "active_context_sources": [
        "demo_goal",
        "demo_portfolio",
        "demo_suggestions",
        "demo_top_pick",
        "content/demo-mode-copy.md",
        "content/smith-ai-copy.md"
      ],
      "allowed_explanations": [
        "what Demo Mode is",
        "that values are sample data",
        "why a demo suggestion appears",
        "why demo Top Pick was selected",
        "why a demo suggestion is locked",
        "how to connect a wallet",
        "what changes after connecting a wallet"
      ],
      "approved_response_pattern": "In this demo, {topic} uses sample data. Connect a wallet to see WealthSmith use your own portfolio and saved plan settings.",
      "must_include_when_relevant": [
        "In this demo",
        "sample data",
        "not your real wallet",
        "Connect a wallet to see your own portfolio"
      ],
      "must_not_include": [
        "your real portfolio",
        "your wallet shows",
        "I chose this Top Pick",
        "guaranteed",
        "risk-free",
        "transaction submitted",
        "funds moved",
        "send your seed phrase",
        "send your private key"
      ],
      "must_not_invent": [
        "real wallet balances",
        "real recommendations",
        "APY",
        "estimated earnings",
        "protocol destinations",
        "Top Pick",
        "reason codes"
      ]
    },
    "state_transitions": {
      "enter_demo_mode": {
        "trigger": "try_demo_mode",
        "from_states": [
          "no_wallet",
          "onboarding_no_wallet",
          "support_no_wallet"
        ],
        "result": {
          "demo_mode": true,
          "is_sample_data": true,
          "wallet_status": "demo",
          "wallet_pill_visible": false,
          "demo_banner_visible": true,
          "load_demo_goal": true,
          "load_demo_portfolio": true,
          "load_demo_suggestions": true,
          "load_demo_top_pick": true
        },
        "toast": {
          "message": "Demo Mode started",
          "content_id": "demo.toast.started"
        },
        "hard_rules": [
          "Entering Demo Mode does not connect a wallet.",
          "Entering Demo Mode does not request a signature.",
          "Entering Demo Mode must clearly label sample data."
        ]
      },
      "exit_demo_mode": {
        "trigger": "exit_demo",
        "result": {
          "demo_mode": false,
          "clear_demo_goal": true,
          "clear_demo_portfolio": true,
          "clear_demo_suggestions": true,
          "clear_demo_top_pick": true,
          "wallet_status": "disconnected",
          "wallet_pill_visible": false,
          "next_state": "{no_wallet_dashboard|onboarding|public_landing}"
        },
        "toast": {
          "message": "Demo Mode exited",
          "content_id": "demo.toast.exited"
        },
        "hard_rules": [
          "Exiting Demo Mode clears demo-dependent state.",
          "Exiting Demo Mode does not affect real wallet funds.",
          "Do not persist Demo Top Pick after exit."
        ]
      },
      "connect_wallet_from_demo": {
        "trigger": "connect_wallet",
        "result": {
          "open_connect_wallet_modal": true,
          "on_success": {
            "demo_mode": false,
            "clear_demo_data": true,
            "wallet_status": "connected",
            "wallet_pill_visible": true,
            "load_real_wallet_portfolio": true,
            "generate_real_suggestions": true,
            "generate_real_top_pick": true
          }
        },
        "hard_rules": [
          "Real wallet state replaces demo state after successful wallet connection.",
          "Demo suggestions and Demo Top Pick must not carry into real wallet mode.",
          "Wallet connection is read-only for MVP portfolio viewing."
        ]
      },
      "open_demo_protocol_handoff": {
        "trigger": "demo_suggestion_protocol_cta",
        "result": {
          "handoff_type": "external_new_tab_or_blocked_until_unlocked",
          "executes_transaction": false,
          "requires_wallet_signature": false,
          "marks_suggestion_complete": false
        },
        "hard_rules": [
          "Demo protocol handoff is review-only.",
          "Demo protocol handoff does not execute transactions.",
          "Demo protocol handoff does not request wallet signatures.",
          "Demo protocol handoff does not mark suggestions complete on click."
        ]
      }
    },
    "loading_error_states": {
      "template_reference": "templates/empty-error-loading-state-template.json",
      "loading": {
        "status": "loading",
        "title": "Loading Demo Mode",
        "description": "Preparing sample portfolio and suggestions.",
        "show_skeleton": true,
        "show_smith_ai_animation": false,
        "hard_rules": [
          "Do not show partial fake values outside the approved demo fixture.",
          "Do not use Smith AI animation for general page loading."
        ]
      },
      "error": {
        "status": "error",
        "title": "We couldn’t load Demo Mode",
        "description": "Try again in a moment.",
        "cta": "Retry",
        "hard_rules": [
          "Do not fall back to fake unlabeled data.",
          "Do not show demo data unless demo fixture is ready."
        ]
      }
    },
    "copy": {
      "demo_banner_title": "Demo Mode",
      "demo_banner_description": "You’re viewing sample data. Connect a wallet to see your own portfolio.",
      "sample_data_badge": "Sample Data",
      "connect_wallet_cta": "Connect Wallet",
      "exit_demo_cta": "Exit Demo",
      "demo_started_toast": "Demo Mode started",
      "demo_exited_toast": "Demo Mode exited",
      "demo_explanation": "Demo Mode lets you explore WealthSmith with sample data before connecting a wallet.",
      "content_ids": {
        "banner_title": "demo.banner.title",
        "banner_description": "demo.banner.description",
        "sample_data_badge": "demo.badge.sample_data",
        "connect_wallet_cta": "wallet.connect.cta",
        "exit_demo_cta": "demo.cta.exit_demo",
        "started_toast": "demo.toast.started",
        "exited_toast": "demo.toast.exited",
        "explanation": "demo.explanation"
      },
      "forbidden_copy": [
        "your real portfolio",
        "based on your wallet",
        "wallet connected",
        "transaction submitted",
        "funds moved",
        "guaranteed",
        "risk-free"
      ]
    },
    "accessibility": {
      "demo_banner_label": "Demo Mode notice",
      "sample_data_label": "Sample data",
      "connect_wallet_label": "Connect Wallet to use your own portfolio",
      "exit_demo_label": "Exit Demo Mode",
      "ask_smith_ai_label": "Ask Smith AI about this demo",
      "hard_rules": [
        "Sample data must be identified in text, not only by color.",
        "Demo banner must be accessible to screen readers.",
        "Connect Wallet and Exit Demo actions must have clear labels.",
        "Demo and real wallet states must be distinguishable without visual-only cues."
      ]
    },
    "analytics_or_events": {
      "demo_started": {
        "event_name": "demo_started",
        "payload": {
          "mode": "demo",
          "is_sample_data": true,
          "wallet_connected": false
        }
      },
      "demo_exited": {
        "event_name": "demo_exited",
        "payload": {
          "mode": "demo",
          "wallet_connected": false
        }
      },
      "demo_connect_wallet_clicked": {
        "event_name": "demo_connect_wallet_clicked",
        "payload": {
          "from_mode": "demo",
          "opens_wallet_modal": true,
          "executes_transaction": false
        }
      },
      "must_not_include": [
        "seed_phrase",
        "private_key",
        "wallet_password",
        "real_wallet_address"
      ]
    },
    "validation": {
      "required_fields": [
        "id",
        "source",
        "status",
        "mode",
        "demo_mode",
        "is_sample_data",
        "sample_data_label_required",
        "wallet_state",
        "global_nav",
        "demo_banner",
        "demo_goal",
        "demo_portfolio",
        "demo_suggestions",
        "demo_top_pick",
        "smith_ai_context",
        "state_transitions",
        "copy",
        "accessibility",
        "hard_rules"
      ],
      "conditional_required_fields": [
        {
          "when": "demo_mode = true",
          "required": [
            "demo_banner.visible",
            "wallet_state.wallet_pill_visible",
            "is_sample_data",
            "sample_data_label_required"
          ]
        },
        {
          "when": "demo_suggestions.status = ready",
          "required": [
            "demo_suggestions.suggestions"
          ]
        },
        {
          "when": "demo_top_pick.has_top_pick = true",
          "required": [
            "demo_top_pick.top_pick_id",
            "demo_top_pick.top_pick_title",
            "demo_top_pick.selection_reason"
          ]
        }
      ],
      "global_assertions": [
        {
          "id": "demo_mode_true",
          "assertion": "Demo Mode state has demo_mode = true.",
          "expected": true
        },
        {
          "id": "sample_data_true",
          "assertion": "Demo Mode state has is_sample_data = true.",
          "expected": true
        },
        {
          "id": "demo_banner_visible",
          "assertion": "Demo banner is visible in Demo Mode.",
          "expected": true
        },
        {
          "id": "wallet_pill_hidden",
          "assertion": "Wallet pill is hidden in Demo Mode.",
          "expected": true
        },
        {
          "id": "no_wallet_signature",
          "assertion": "Demo Mode does not request wallet signatures.",
          "expected": true
        },
        {
          "id": "demo_data_not_real",
          "assertion": "Demo copy labels data as sample and not real wallet data.",
          "expected": true
        },
        {
          "id": "demo_top_pick_not_persistent",
          "assertion": "Demo Top Pick is cleared when connecting a real wallet or exiting demo.",
          "expected": true
        },
        {
          "id": "smith_ai_demo_aware",
          "assertion": "Smith AI uses demo-aware sample-data language.",
          "expected": true
        }
      ],
      "forbidden_fields_or_values": [
        "private_key",
        "seed_phrase",
        "wallet_password",
        "wallet_backup_file",
        "demo_mode = false",
        "is_sample_data = false",
        "wallet_pill_visible = true",
        "real_wallet_connected = true",
        "can_move_funds = true",
        "can_trade = true",
        "can_sign_transactions = true",
        "demo_banner.visible = false",
        "copy saying demo data is real wallet data",
        "demo Top Pick persisted into real wallet mode"
      ]
    },
    "hard_rules": [
      "This is a template, not production demo data.",
      "Demo Mode must set demo_mode = true.",
      "Demo Mode must set is_sample_data = true.",
      "Demo Mode must clearly label sample data.",
      "Demo Mode must show the demo banner.",
      "Demo banner must sit outside Global Nav.",
      "Demo Mode must not show wallet pill.",
      "Demo Mode must not imply a real wallet is connected.",
      "Demo Mode must not request wallet signatures.",
      "Demo Mode must not execute transactions.",
      "Demo suggestions are sample suggestions, not real recommendations.",
      "Demo Top Pick is sample-only and must not persist into real wallet mode.",
      "Connecting a wallet from Demo Mode must clear demo-dependent portfolio, suggestions, Top Pick, and Smith AI context.",
      "Smith AI must use demo-aware language when explaining Demo Mode.",
      "Do not invent demo balances, APY, earnings, projections, suggestions, Top Pick, reason codes, or protocol destinations.",
      "Do not ask for seed phrases, private keys, passwords, or wallet backup files.",
      "Do not imply WealthSmith holds, controls, moves, trades, swaps, stakes, deposits, withdraws, or rebalances user funds."
    ]
  }
}
