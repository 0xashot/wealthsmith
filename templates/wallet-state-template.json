{
  "template_metadata": {
    "name": "Wallet State Template",
    "path": "templates/wallet-state-template.json",
    "purpose": "Reusable structure for WealthSmith wallet connection state used by Global Nav, Connect Wallet modal, wallet menu, Portfolio loading, Suggestions, Smith AI, QA, and analytics.",
    "template_type": "json_contract_template",
    "source_of_truth": [
      "rules/wallet-and-custody-rules.md",
      "rules/financial-logic-boundaries.md",
      "rules/demo-mode-rules.md",
      "rules/loading-state-rules.md",
      "rules/smith-ai-rules.md"
    ],
    "related_content": [
      "content/wallet-copy.md",
      "content/demo-mode-copy.md",
      "content/smith-ai-copy.md",
      "content/empty-error-loading-copy.md",
      "content/glossary.md"
    ],
    "related_components": [
      "components/global-nav.md",
      "components/button.md",
      "components/modal.md",
      "components/menu-popover.md",
      "components/menu-item.md",
      "components/toast.md",
      "components/icon.md",
      "components/skeleton.md",
      "components/empty-state.md"
    ],
    "related_patterns": [
      "patterns/wallet-connection.md",
      "patterns/dashboard-layout.md",
      "patterns/portfolio-overview.md",
      "patterns/empty-loading-error-states.md"
    ],
    "related_templates": [
      "templates/page-state-template.json",
      "templates/demo-mode-state-template.json",
      "templates/smith-ai-context-template.json",
      "templates/empty-error-loading-state-template.json"
    ],
    "related_examples": [
      "examples/wallet/wallet-connected-phantom-state.json",
      "examples/dashboard/dashboard-connected-wallet-state.json",
      "examples/portfolio/portfolio-liquid-assets.json"
    ],
    "notes": [
      "This is a template, not production wallet state.",
      "Wallet state is separate from portfolio data readiness.",
      "Wallet connection is read-only for portfolio viewing in MVP.",
      "WealthSmith must not imply custody, fund movement, or transaction authority."
    ]
  },
  "wallet_state": {
    "id": "{wallet_state_id}",
    "source": "{wallet_adapter|wallet_state_builder|demo_state_builder|test_fixture}",
    "status": "{disconnected|connecting|connected|error|unsupported|demo}",
    "generated_at": "{timestamp_from_system}",
    "mode": "{real_wallet|demo|no_wallet|onboarding}",
    "demo_mode": "{boolean}",
    "network": {
      "id": "solana",
      "label": "Solana",
      "supported": true,
      "unsupported_reason": "{unsupported_network_reason_or_null}"
    },
    "provider": {
      "id": "{phantom|solflare|backpack|null}",
      "label": "{Phantom|Solflare|Backpack|null}",
      "icon": "{assets/icons/wallet/{provider_id}.svg|null}",
      "supported": "{boolean}",
      "installed": "{boolean_or_unknown}",
      "connection_available": "{boolean}",
      "unsupported_reason": "{unsupported_wallet|not_installed|network_mismatch|unknown|null}"
    },
    "supported_providers": [
      {
        "id": "phantom",
        "label": "Phantom",
        "icon": "assets/icons/wallet/phantom.svg",
        "supported": true
      },
      {
        "id": "solflare",
        "label": "Solflare",
        "icon": "assets/icons/wallet/solflare.svg",
        "supported": true
      },
      {
        "id": "backpack",
        "label": "Backpack",
        "icon": "assets/icons/wallet/backpack.svg",
        "supported": true
      }
    ],
    "address": {
      "full": "{wallet_public_address_or_null}",
      "short": "{short_address_or_null}",
      "display_default": "short",
      "is_synthetic": "{boolean_for_fixtures_only}",
      "full_address_available_to_ui": "{boolean}",
      "full_address_available_to_smith_ai": false,
      "copyable": "{boolean_when_connected}"
    },
    "connection": {
      "type": "{read_only_portfolio_view|none|demo}",
      "status": "{not_started|prompt_open|awaiting_user_approval|connected|rejected|failed|timed_out|unsupported}",
      "connected_at": "{timestamp_or_null}",
      "last_checked_at": "{timestamp_or_null}",
      "requires_message_signature": "{boolean_from_product_flow}",
      "requires_transaction_signature": false,
      "message_signature_status": "{not_required|required|pending|approved|rejected|failed|ledger_unavailable|null}",
      "transaction_signature_status": "not_required",
      "hard_rules": [
        "Basic portfolio viewing should be read-only.",
        "Wallet connection must not imply transaction approval.",
        "Transaction signatures are not required for MVP wallet handoff clicks.",
        "Do not ask for seed phrase or private key."
      ]
    },
    "permissions": {
      "can_read_public_address": "{boolean}",
      "can_read_supported_balances": "{boolean}",
      "can_read_supported_positions": "{boolean}",
      "can_move_funds": false,
      "can_trade": false,
      "can_swap": false,
      "can_stake": false,
      "can_unstake": false,
      "can_deposit": false,
      "can_withdraw": false,
      "can_rebalance": false,
      "can_sign_transactions": false,
      "can_export_keys": false,
      "hard_rules": [
        "Read-only connection does not grant fund movement permission.",
        "Do not expose unsupported wallet actions in UI.",
        "Do not imply WealthSmith can trade, stake, deposit, withdraw, rebalance, or move assets."
      ]
    },
    "global_nav_integration": {
      "wallet_pill_visible": "{boolean}",
      "wallet_pill": {
        "component": "button",
        "variant": "wallet_pill",
        "label": "{wallet_provider} • {short_address}",
        "icon": "{wallet_provider_icon_path_or_null}",
        "action": "open_wallet_menu",
        "content_id": "wallet.connected.pill",
        "accessibility_label": "Connected wallet: {wallet_provider}, address ending {short_address}. Open wallet menu.",
        "hard_rules": [
          "Show wallet pill only after wallet connection is confirmed.",
          "Do not show wallet pill in Demo Mode.",
          "Do not show full address by default in Global Nav.",
          "Wallet pill does not prove portfolio data is fully loaded."
        ]
      },
      "connect_wallet_cta": {
        "visible": "{boolean}",
        "label": "Connect Wallet",
        "action": "open_connect_wallet_modal",
        "content_id": "wallet.connect.cta"
      },
      "try_demo_mode_cta": {
        "visible": "{boolean}",
        "label": "Try Demo Mode",
        "action": "enter_demo_mode",
        "content_id": "demo.cta.try_demo_mode"
      }
    },
    "connect_wallet_modal": {
      "component": "modal",
      "visible_when": "status = disconnected and user opens Connect Wallet",
      "title": "Connect Wallet",
      "description": "{copy_from_wallet_content}",
      "content_id": "wallet.connect.modal.title",
      "provider_options": [
        {
          "provider_id": "phantom",
          "label": "Phantom",
          "icon": "assets/icons/wallet/phantom.svg",
          "enabled": "{boolean}",
          "action": "connect_phantom"
        },
        {
          "provider_id": "solflare",
          "label": "Solflare",
          "icon": "assets/icons/wallet/solflare.svg",
          "enabled": "{boolean}",
          "action": "connect_solflare"
        },
        {
          "provider_id": "backpack",
          "label": "Backpack",
          "icon": "assets/icons/wallet/backpack.svg",
          "enabled": "{boolean}",
          "action": "connect_backpack"
        }
      ],
      "helper_text": "WealthSmith reads supported wallet data. It cannot move funds from a read-only connection.",
      "security_note": "Never share your seed phrase or private key.",
      "hard_rules": [
        "Only show supported MVP wallets.",
        "Do not ask user to paste wallet secrets.",
        "Do not say WealthSmith will secure the wallet.",
        "Do not imply connecting wallet executes a transaction."
      ]
    },
    "wallet_menu": {
      "component": "menu-popover",
      "visible_when": "wallet_pill opened",
      "header": {
        "provider": "{wallet_provider}",
        "address_display": "Address ending {short_address}",
        "copy_address_action": {
          "visible": "{boolean}",
          "label": "Copy Address",
          "action": "copy_wallet_address",
          "toast": "Address copied",
          "content_id": "wallet.menu.copy_address"
        }
      },
      "items": [
        {
          "id": "disconnect_wallet",
          "component": "menu-item",
          "label": "Disconnect Wallet",
          "action": "disconnect_wallet",
          "content_id": "wallet.menu.disconnect",
          "destructive": false
        }
      ],
      "helper": {
        "text": "Your funds stay in your wallet.",
        "content_id": "wallet.non_custodial.short"
      },
      "forbidden_items": [
        "Transfer Funds",
        "Export Private Key",
        "Export Seed Phrase",
        "Recover Wallet",
        "Stake All",
        "Swap Now",
        "Withdraw",
        "Rebalance"
      ],
      "hard_rules": [
        "Wallet menu should stay simple in MVP.",
        "Do not expose unsupported actions.",
        "Do not include wallet-secret actions.",
        "Disconnect Wallet does not move funds."
      ]
    },
    "portfolio_loading_separation": {
      "wallet_connection_status": "{connected|disconnected|connecting|error|demo}",
      "portfolio_data_status": "{not_requested|loading|ready|partial|empty|error|stale|unavailable}",
      "supported_position_statuses": {
        "liquid_assets": "{not_requested|loading|ready|partial|empty|error|stale|unavailable}",
        "staked_assets": "{not_requested|loading|ready|partial|empty|error|stale|unavailable}",
        "yield_strategies": "{not_requested|loading|ready|partial|empty|error|stale|unavailable}"
      },
      "loading_copy": "Loading wallet positions...",
      "partial_copy": "Some wallet positions are unavailable.",
      "error_copy": "We couldn’t load portfolio data. Try again in a moment. Your funds stay in your wallet.",
      "empty_copy": "WealthSmith did not find supported assets in this wallet.",
      "hard_rules": [
        "Wallet connected does not mean portfolio data is ready.",
        "Keep wallet pill visible if portfolio loading fails but wallet remains connected.",
        "Do not show fake balances while portfolio data loads.",
        "Do not say wallet is empty if unsupported assets may exist.",
        "Portfolio loading errors must not imply funds are affected."
      ]
    },
    "connect_flow": {
      "states": [
        {
          "id": "disconnected",
          "description": "No wallet connected.",
          "visible_ui": [
            "Connect Wallet CTA",
            "optional Try Demo Mode CTA"
          ]
        },
        {
          "id": "connecting",
          "description": "Wallet connection has started.",
          "visible_ui": [
            "connecting state in modal",
            "non-blocking helper text"
          ]
        },
        {
          "id": "awaiting_user_approval",
          "description": "User must approve connection in wallet provider.",
          "visible_ui": [
            "approval helper copy"
          ]
        },
        {
          "id": "connected",
          "description": "Wallet connection confirmed.",
          "visible_ui": [
            "wallet pill",
            "wallet menu",
            "portfolio loading or ready state"
          ]
        },
        {
          "id": "rejected",
          "description": "User rejected wallet connection.",
          "visible_ui": [
            "non-destructive error",
            "Retry CTA"
          ]
        },
        {
          "id": "failed",
          "description": "Connection failed.",
          "visible_ui": [
            "error state",
            "Retry CTA"
          ]
        }
      ],
      "success_result": {
        "wallet_status": "connected",
        "show_wallet_pill": true,
        "hide_connect_wallet_cta": true,
        "hide_try_demo_mode_cta": true,
        "portfolio_data_status": "loading_or_ready_separately",
        "toast": "Wallet connected"
      },
      "success_hard_rules": [
        "Do not say portfolio loaded until portfolio data is ready.",
        "Do not say transaction complete.",
        "Do not say funds moved.",
        "Do not say WealthSmith now controls the wallet."
      ]
    },
    "disconnect_flow": {
      "trigger": "wallet_menu.disconnect_wallet",
      "confirmation_required": false,
      "action": "disconnect_wallet",
      "result": {
        "wallet_status": "disconnected",
        "show_wallet_pill": false,
        "clear_wallet_dependent_real_data": true,
        "clear_portfolio_data": true,
        "clear_suggestion_engine_output": true,
        "clear_top_pick_output": true,
        "clear_protocol_decisions": true,
        "clear_real_wallet_smith_ai_context": true,
        "funds_affected": false,
        "next_state": "{dashboard_no_wallet_state|connect_wallet_prompt|previous_public_state}"
      },
      "toast": {
        "message": "Wallet disconnected",
        "content_id": "wallet.disconnected.toast"
      },
      "helper": {
        "message": "Your funds stay in your wallet.",
        "content_id": "wallet.non_custodial.short"
      },
      "hard_rules": [
        "Disconnecting wallet does not move funds.",
        "Disconnecting wallet does not delete assets.",
        "Disconnecting wallet only removes the app connection and clears wallet-dependent app state.",
        "Do not call disconnecting Log Out unless account authentication exists."
      ]
    },
    "message_signing_and_ledger": {
      "message_signing_policy": {
        "basic_portfolio_view_requires_message_signature": "{boolean_from_product_decision}",
        "recommended_mvp_default": false,
        "reason": "Avoid blocking read-only portfolio viewing, especially for Ledger-backed wallets.",
        "hard_rule": "Do not request transaction signatures for basic portfolio viewing."
      },
      "ledger_state": {
        "detected_or_reported": "{boolean_or_unknown}",
        "wallet_provider": "{phantom|solflare|backpack|null}",
        "error_code": "{ledger_message_signing_unavailable|signature_not_prompted_on_device|blind_signing_issue|unknown|null}",
        "user_visible_title": "Wallet connection needs another method",
        "user_visible_description": "This wallet may not support the current message signing flow. Try connecting without message signing if available, or use another supported wallet.",
        "fallback_available": "{boolean_from_engineering}",
        "hard_rules": [
          "Do not blame the user.",
          "Do not ask for seed phrase or private key.",
          "Do not require message signing for read-only viewing if product supports signatureless connection.",
          "Transaction signing may still be required later for user-initiated transactions outside MVP read-only viewing."
        ]
      }
    },
    "error_states": {
      "user_rejected_connection": {
        "status": "error",
        "title": "Connection canceled",
        "description": "You canceled the wallet connection.",
        "cta": "Try Again",
        "content_ids": {
          "title": "wallet.error.connection_canceled.title",
          "description": "wallet.error.connection_canceled.description",
          "cta": "common.cta.try_again"
        },
        "hard_rules": [
          "Do not present user rejection as a security issue.",
          "Do not clear existing wallet state unless a new connection replaced it."
        ]
      },
      "wallet_not_installed": {
        "status": "error",
        "title": "Wallet not found",
        "description": "Install a supported wallet or choose another option.",
        "cta": "Choose Another Wallet",
        "content_ids": {
          "title": "wallet.error.not_found.title",
          "description": "wallet.error.not_found.description",
          "cta": "wallet.cta.choose_another"
        }
      },
      "unsupported_wallet": {
        "status": "unsupported",
        "title": "Wallet not supported",
        "description": "WealthSmith supports Phantom, Solflare, and Backpack in MVP.",
        "cta": "Choose Supported Wallet",
        "content_ids": {
          "title": "wallet.error.unsupported.title",
          "description": "wallet.error.unsupported.description",
          "cta": "wallet.cta.choose_supported"
        }
      },
      "unsupported_network": {
        "status": "error",
        "title": "Unsupported network",
        "description": "WealthSmith supports Solana wallets in MVP.",
        "cta": "Switch Network",
        "content_ids": {
          "title": "wallet.error.unsupported_network.title",
          "description": "wallet.error.unsupported_network.description",
          "cta": "wallet.cta.switch_network"
        }
      },
      "connection_failed": {
        "status": "error",
        "title": "We couldn’t connect your wallet",
        "description": "Try again in a moment. Your funds stay in your wallet.",
        "cta": "Retry",
        "content_ids": {
          "title": "wallet.error.connection_failed.title",
          "description": "wallet.error.connection_failed.description",
          "cta": "common.cta.retry"
        }
      },
      "portfolio_load_failed_after_connection": {
        "status": "partial_or_error",
        "title": "We couldn’t load portfolio data",
        "description": "Try again in a moment. Your funds stay in your wallet.",
        "cta": "Retry",
        "content_ids": {
          "title": "portfolio.error.load_failed.title",
          "description": "portfolio.error.load_failed.description",
          "cta": "common.cta.retry"
        },
        "hard_rule": "Keep wallet connected if the wallet connection is still valid."
      }
    },
    "copy": {
      "connect_wallet_cta": "Connect Wallet",
      "connected_toast": "Wallet connected",
      "disconnected_toast": "Wallet disconnected",
      "wallet_pill_format": "{wallet_provider} • {short_address}",
      "disconnect_menu_item": "Disconnect Wallet",
      "copy_address": "Copy Address",
      "address_copied_toast": "Address copied",
      "read_only_explanation": "Read-only means WealthSmith can use public wallet and supported protocol data to show your portfolio and suggestions. It does not give WealthSmith permission to move funds.",
      "non_custodial_explanation": "WealthSmith is non-custodial. Your funds stay in your wallet, and WealthSmith does not hold your crypto or private keys.",
      "security_warning": "Never share your seed phrase or private key.",
      "content_ids": {
        "connect_cta": "wallet.connect.cta",
        "connected_toast": "wallet.connected.toast",
        "disconnected_toast": "wallet.disconnected.toast",
        "wallet_pill": "wallet.connected.pill",
        "disconnect_menu": "wallet.menu.disconnect",
        "copy_address": "wallet.menu.copy_address",
        "address_copied_toast": "wallet.menu.address_copied",
        "read_only": "wallet.read_only.explanation",
        "non_custodial": "wallet.non_custodial.explanation",
        "seed_phrase_warning": "wallet.security.seed_phrase"
      },
      "forbidden_copy": [
        "WealthSmith controls your wallet",
        "Your funds are secured by WealthSmith",
        "Wallet connected, transaction approved",
        "Funds moved",
        "Send your seed phrase",
        "Send your private key",
        "Export your key"
      ]
    },
    "smith_ai_context": {
      "template_reference": "templates/smith-ai-context-template.json",
      "allowed": true,
      "context_mode": "{real_wallet|demo|no_wallet|onboarding}",
      "can_explain": [
        "what connecting a wallet means",
        "read-only wallet behavior",
        "why wallet pill is visible or hidden",
        "why portfolio data may still be loading",
        "what disconnecting does",
        "supported wallets in MVP",
        "seed phrase and private key safety",
        "Ledger/message signing limitation if provided in state"
      ],
      "approved_response_pattern": "Connecting {wallet_provider} lets WealthSmith read supported wallet balances and positions so it can personalize your dashboard and suggestions. Your funds stay in your wallet, and WealthSmith does not get permission to move funds from a read-only connection.",
      "must_include_when_relevant": [
        "read supported wallet balances and positions",
        "funds stay in your wallet",
        "does not get permission to move funds",
        "Never share your seed phrase or private key"
      ],
      "must_not_include": [
        "WealthSmith controls your wallet",
        "WealthSmith can move funds",
        "wallet connection authorizes transactions",
        "transaction submitted",
        "funds moved",
        "send your seed phrase",
        "send your private key"
      ]
    },
    "analytics_or_events": {
      "wallet_connect_started": {
        "event_name": "wallet_connect_started",
        "payload": {
          "wallet_provider": "{provider_id}",
          "network": "solana",
          "demo_mode": "{boolean}"
        }
      },
      "wallet_connected": {
        "event_name": "wallet_connected",
        "payload": {
          "wallet_provider": "{provider_id}",
          "network": "solana",
          "connection_type": "{connection_type}",
          "demo_mode": false
        },
        "must_not_include": [
          "seed_phrase",
          "private_key",
          "wallet_password",
          "wallet_backup_file"
        ]
      },
      "wallet_connection_failed": {
        "event_name": "wallet_connection_failed",
        "payload": {
          "wallet_provider": "{provider_id_or_null}",
          "network": "solana",
          "error_code": "{error_code}",
          "user_rejected": "{boolean}"
        }
      },
      "wallet_menu_opened": {
        "event_name": "wallet_menu_opened",
        "payload": {
          "wallet_provider": "{provider_id}",
          "wallet_status": "connected"
        }
      },
      "wallet_disconnected": {
        "event_name": "wallet_disconnected",
        "payload": {
          "wallet_provider": "{provider_id}",
          "funds_affected": false
        }
      }
    },
    "accessibility": {
      "connect_wallet_button_label": "Connect Wallet",
      "connect_wallet_modal_label": "Connect Wallet",
      "provider_option_label": "Connect {wallet_provider}",
      "wallet_pill_aria_label": "Connected wallet: {wallet_provider}, address ending {short_address}. Open wallet menu.",
      "wallet_menu_label": "Wallet menu",
      "copy_address_label": "Copy wallet address",
      "disconnect_wallet_label": "Disconnect Wallet",
      "connection_loading_label": "Connecting wallet",
      "connection_error_label": "{error_title}",
      "security_warning_announcement": "Never share your seed phrase or private key.",
      "hard_rules": [
        "Wallet provider icons must not be the only label.",
        "Wallet menu must be keyboard accessible.",
        "Connection errors must be announced in readable text.",
        "External wallet approval state must be clear without visual-only cues."
      ]
    },
    "validation": {
      "required_fields": [
        "id",
        "source",
        "status",
        "mode",
        "demo_mode",
        "network",
        "provider",
        "address",
        "connection",
        "permissions",
        "global_nav_integration",
        "portfolio_loading_separation",
        "connect_flow",
        "disconnect_flow",
        "copy",
        "accessibility",
        "hard_rules"
      ],
      "conditional_required_fields": [
        {
          "when": "status = connected",
          "required": [
            "provider.id",
            "provider.label",
            "provider.icon",
            "address.short",
            "connection.type",
            "global_nav_integration.wallet_pill",
            "wallet_menu",
            "permissions.can_read_public_address"
          ]
        },
        {
          "when": "status = disconnected",
          "required": [
            "global_nav_integration.connect_wallet_cta"
          ]
        },
        {
          "when": "status = demo or demo_mode = true",
          "required": [
            "demo_mode",
            "global_nav_integration.wallet_pill_visible"
          ]
        },
        {
          "when": "connection.message_signature_status = ledger_unavailable",
          "required": [
            "message_signing_and_ledger.ledger_state"
          ]
        },
        {
          "when": "portfolio_loading_separation.portfolio_data_status = error",
          "required": [
            "error_states.portfolio_load_failed_after_connection"
          ]
        }
      ],
      "global_assertions": [
        {
          "id": "read_only_permissions",
          "assertion": "Read-only wallet state does not allow fund movement or trading permissions.",
          "expected": true
        },
        {
          "id": "wallet_pill_connected_only",
          "assertion": "Wallet pill appears only when wallet is connected and demo_mode is false.",
          "expected": true
        },
        {
          "id": "demo_has_no_wallet_pill",
          "assertion": "Demo Mode does not show wallet pill.",
          "expected": true
        },
        {
          "id": "portfolio_loading_separate",
          "assertion": "Wallet connection state is separate from portfolio data state.",
          "expected": true
        },
        {
          "id": "disconnect_no_funds_affected",
          "assertion": "Disconnecting wallet does not affect funds.",
          "expected": true
        },
        {
          "id": "no_wallet_secrets",
          "assertion": "No wallet flow asks for seed phrase or private key.",
          "expected": true
        },
        {
          "id": "supported_wallets_only",
          "assertion": "MVP wallet options are Phantom, Solflare, and Backpack.",
          "expected": true
        }
      ],
      "forbidden_fields_or_values": [
        "private_key",
        "seed_phrase",
        "wallet_password",
        "wallet_backup_file",
        "can_move_funds = true",
        "can_trade = true",
